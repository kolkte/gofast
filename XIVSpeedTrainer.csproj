<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.0.1</Version>
		<Author>kolkte</Author>
		<Name>XIVSpeedTrainer</Name>
		<Punchline>Movement speed trainer</Punchline>
		<Description>Adjusts player movement speed.</Description>
		<RepoUrl>https://github.com/kolkte/gofast</RepoUrl>
		<Tags>speed</Tags>
	</PropertyGroup>

	<Target Name="CopyNativeDll" AfterTargets="Build">
		<Copy SourceFiles="$(SolutionDir)SpeedHook\bin\x64\$(Configuration)\SpeedHook.dll"
			  DestinationFolder="$(OutputPath)"
			  Condition="Exists('$(SolutionDir)SpeedHook\bin\x64\$(Configuration)\SpeedHook.dll')" />
	</Target>
</Project>